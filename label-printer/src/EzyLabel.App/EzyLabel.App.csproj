<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the exe be built on a non-Windows machine. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>EzyPOS Label Printer</AssemblyName>
    <RootNamespace>EzyLabel.App</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Company>EzyPOS</Company>
    <Product>EzyPOS Label Printer</Product>
    <Description>Barcode label printing for the TSC TTP-244 Pro, driven from EzyPOS</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EzyLabel.Core/EzyLabel.Core.csproj" />
  </ItemGroup>
</Project>
